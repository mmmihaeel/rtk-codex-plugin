#!/usr/bin/env python3
"""Codex PreToolUse hook that rewrites eligible shell commands through RTK."""

from __future__ import annotations

import base64
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Any


BYPASS_ENV = {
    "RTK_CODEX_HOOK_DISABLE",
    "RTK_CODEX_BYPASS",
    "RTK_DISABLE",
    "RTK_DISABLED",
}


}
MACHINE_FLAGS = {
    "--json",
    "--format=json",
    "--porcelain",
    "--porcelain=v1",
    "--porcelain=v2",
    "--machine-readable",
    "-json",
}
MACHINE_VALUE_FLAGS = {"--format", "--output", "-o"}
MACHINE_VALUES = {"json", "jsonpath", "machine-readable", "porcelain", "yaml", "yml"}
GIT_STATUS_EXACT_FLAGS = {"--branch", "--porcelain", "--porcelain=v1", "--porcelain=v2", "--short", "-s", "-z"}
GIT_STATUS_EXACT_SHORT_FLAGS = {"b", "s", "z"}
CONTROL_MARKERS = ("|", ">", "<", "$(", "`", "&&", "||", ";", "\n", "\r", "&")
SHELL_GROUPING_PATTERN = re.compile(r"(^|\s)\([^)]*\)($|\s)")
RG_EXACT_OUTPUT_SHORT_FLAGS = {"0", "c", "l", "L"}
GREP_EXACT_OUTPUT_SHORT_FLAGS = {"c", "l", "m", "q"}
RTK_REWRITE_SUCCESS_CODES = {0, 3}
MAX_REWRITE_COMMAND_BYTES = 16 * 1024
RISKY_LONG_LINE_EXTENSIONS = {
    ".jsonl",
    ".ndjson",
    ".json",
    ".log",
    ".log.*",
}
PIPELINE_TEXT_PRODUCERS = {"awk", "cat", "find", "git", "grep", "jq", "nl", "rg", "sed"}
LINE_LIMITING_COMMANDS = {"head", "tail"}
LONG_LINE_FILTER_COMMANDS = {"grep", "rg"}
PITLANE_SOURCE_EXTS = {
    ".bash",
    ".c",
    ".cc",
    ".cjs",
    ".clj",
